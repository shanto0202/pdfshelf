# ==========================================
# PDFshelf - Git Ignore
# ==========================================

# Environment variables / Secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Local database
data/db.json
data/*.tmp

# Uploaded/private PDF files
storage/pdfs/*.pdf

# Keep empty PDF storage folder in Git
!storage/pdfs/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating system files
.DS_Store
Thumbs.db

# VS Code local settings
.vscode/

# Temporary files
*.tmp
*.temp